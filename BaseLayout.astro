---
import { profile } from '../data/profile.js';
import '../styles/global.css';

const { title, description = 'Biostatistics · Data Science · Machine Learning · Epidemiology · Scientific Software' } = Astro.props;
const navItems = [
  { href: '/', label: 'About' },
  { href: '/cv/', label: 'CV' },
  { href: '/projects/', label: 'Projects' },
  { href: '/publications/', label: 'Publications' },
  { href: '/blog/', label: 'Blog' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · {profile.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Applied before paint, so there's no flash of the wrong theme.
      const saved = localStorage.getItem('theme');
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.setAttribute('data-theme', saved);
      }
    </script>
  </head>
  <body>
    <nav class="top">
      <div class="wrap">
        <a class="brand" href="/" style="text-decoration:none;">
          <div class="brand-mark">{profile.initials.charAt(0)}</div>
          <div class="brand-text"><strong>{profile.name}</strong> — Biostatistics &amp; AI</div>
        </a>
        <div class="nav-links">
          {navItems.map((item) => (
            <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
          ))}
          <button class="theme-toggle" id="theme-toggle" aria-label="Toggle light/dark theme" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <span id="theme-toggle-label">Theme</span>
          </button>
        </div>
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap">
        <div class="nav-links">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="socials">
          <a class="social-btn" href={`mailto:${profile.email}`} aria-label="Email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
          <a class="social-btn" href={`https://github.com/${profile.githubUser}`} aria-label="GitHub">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
          </a>
          <a class="social-btn" href={profile.linkedin} aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.94 8.5H3.56V21h3.38V8.5ZM5.25 3a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92ZM20.44 21h-3.37v-6.4c0-1.53-.03-3.5-2.13-3.5-2.14 0-2.46 1.67-2.46 3.39V21H9.1V8.5h3.24v1.71h.05c.45-.85 1.55-1.75 3.19-1.75 3.41 0 4.04 2.25 4.04 5.17V21Z"/></svg>
          </a>
          <a class="social-btn" href={`https://orcid.org/${profile.orcid}`} aria-label="ORCID">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-2.4 5.4h1.5v10.2h-1.5V7.4Zm.75-2.9a1 1 0 1 1 0 2 1 1 0 0 1 0-2Zm3.15 2.9h3.6c3.43 0 4.94 2.45 4.94 5.1 0 2.9-2.27 5.1-4.9 5.1h-3.64V7.4Zm1.5 1.36v7.48h1.98c2.5 0 3.55-1.84 3.55-3.75 0-2.03-1.13-3.73-3.58-3.73h-1.95Z"/></svg>
          </a>
        </div>
        <div class="foot-note">{profile.domain}</div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-toggle');
        const label = document.getElementById('theme-toggle-label');
        const current = () => document.documentElement.getAttribute('data-theme')
          || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const render = () => { label.textContent = current() === 'dark' ? 'Dark' : 'Light'; };
        render();
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          render();
        });
      })();
    </script>
  </body>
</html>
