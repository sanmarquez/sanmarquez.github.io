---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog">
  <div class="wrap page-header">
    <p class="eyebrow">Writing</p>
    <h1>Blog &amp; Writing</h1>
    <p>Technical and non-technical posts — research notes, coding experiments, reproducible notebooks.</p>
  </div>

  <main class="wrap">
    <section>
      <div class="blog-teaser">
        <span class="status-badge">In progress</span>
        <p>This section is currently being developed and will host upcoming technical and research writing.</p>
      </div>
    </section>
  </main>
</BaseLayout>
